## create a fun: select wednesdays from df,
##               calc desc stat for the selected values

# Defines a function to calculate descriptive stats for a specific day or all days
fun <- function(x, day = "Wed") {
  
  ## error handling with try|catch|stop
  
  # Stops execution if x is not a data.frame
  if (!is.data.frame(x)) stop()
  
  # Attempts to run the code block, catching any errors
  tryCatch({
  
  # Checks if stats should be calculated for all days
  if (day == "All") {
    
    # Splits the 'val' column by the abbreviated weekday of the 'date' column
    aux <- split(x = x$val,
                 f = format(x = x$date,
                            format = "%a"))
    
    # Applies a function to calculate stats for each weekday group
    out <- lapply(X = aux, 
                  FUN = function(val) {
                    
                    # Returns a named vector w count, mean, sd, and IQR
                    return(c("number of values" = length(x = val),
                             "mean" = mean(x = val, na.rm = TRUE),
                             "sd" = sd(x = val, na.rm = TRUE),
                             "iqr" = IQR(x = val, na.rm = TRUE)))
                  })
    
    # Combines the list of results into a single matrix row by row
    out <- do.call(what = rbind, 
                   args = out)
  } else {
    
    # Filters 'val' where the weekday matches the selected day
    val <- x[format(x = x$date,
                    format = "%a") %in% day, "val"]
    
    # Calculates stats only for the filtered values
    out <- c("number of values" = length(x = val),
             "mean" = mean(x = val, na.rm = TRUE),
             "sd" = sd(x = val, na.rm = TRUE),
             "iqr" = IQR(x = val, na.rm = TRUE))
  }
  
  # Returns the calculated statistics
  out
  
  }, error = function(e){
    
    # Stops execution silently if an error occurs in the block above
    stop()
  })
}

# Calls the function w the default day ("Wed")
fun(x = df)

# Calls the function for Monday ("Mon")
fun(x = df, day = "Mon")

# Calls the function for all days ("All")
fun(x = df, day = "All")
